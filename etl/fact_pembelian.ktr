    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>koneksi_DWH</connection>
    <sql>SELECT 
    pod.PurchaseOrderID AS purchase_order_id,
    pod.PurchaseOrderDetailID AS purchase_order_detail_id,
    DATE(poh.OrderDate) AS order_date,
    CAST(DATE_FORMAT(poh.OrderDate, '%Y%m%d') AS UNSIGNED) AS tanggal_key_sumber,
    pod.ProductID AS product_id,
    poh.VendorID AS vendor_id,
    poh.ShipMethodID AS ship_method_id,
    poh.EmployeeID AS employee_id,
    pod.OrderQty AS jumlah_dipesan,
    pod.ReceivedQty AS jumlah_diterima,
    pod.RejectedQty AS jumlah_ditolak,
    pod.UnitPrice AS harga_satuan,
    pod.LineTotal AS nilai_pembelian,
    COALESCE(DATEDIFF(poh.ShipDate, pod.DueDate), 0) AS selisih_hari_kirim
FROM stg_purchaseorderdetail pod
JOIN stg_purchaseorderheader poh ON pod.PurchaseOrderID = poh.PurchaseOrderID;</sql>
    <limit>0</limit>
    <lookup/>
