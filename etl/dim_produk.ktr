    <connection>koneksi_DWH</connection>
    <sql>-- 1. Produk yang memiliki riwayat perubahan biaya
SELECT 
    p.ProductID AS product_id,
    TRIM(p.Name) AS nama_produk,
    COALESCE(TRIM(m.Name), 'Tanpa Model') AS model_produk,
    COALESCE(TRIM(s.Name), 'Tanpa Kategori') AS subkategori,
    COALESCE(TRIM(c.Name), 'Tanpa Kategori') AS kategori,
    h.StandardCost AS standard_cost,
    DATE(h.StartDate) AS tgl_mulai_efektif,
    COALESCE(DATE(h.EndDate), '9999-12-31') AS tgl_akhir_efektif,
    IF(h.EndDate IS NULL, 'Y', 'N') AS is_current
FROM stg_product p
JOIN stg_productcosthistory h ON p.ProductID = h.ProductID
LEFT JOIN stg_productmodel m ON p.ProductModelID = m.ProductModelID
LEFT JOIN stg_productsubcategory s ON p.ProductSubcategoryID = s.ProductSubcategoryID
LEFT JOIN stg_productcategory c ON s.ProductCategoryID = c.ProductCategoryID

UNION ALL

-- 2. Produk yang tidak pernah berubah biayanya
SELECT 
    p.ProductID AS product_id,
    TRIM(p.Name) AS nama_produk,
    COALESCE(TRIM(m.Name), 'Tanpa Model') AS model_produk,
    COALESCE(TRIM(s.Name), 'Tanpa Kategori') AS subkategori,
    COALESCE(TRIM(c.Name), 'Tanpa Kategori') AS kategori,
    p.StandardCost AS standard_cost,
    COALESCE(DATE(p.SellStartDate), '2011-05-31') AS tgl_mulai_efektif,
    '9999-12-31' AS tgl_akhir_efektif,
    'Y' AS is_current
FROM stg_product p
LEFT JOIN stg_productmodel m ON p.ProductModelID = m.ProductModelID
LEFT JOIN stg_productsubcategory s ON p.ProductSubcategoryID = s.ProductSubcategoryID
LEFT JOIN stg_productcategory c ON s.ProductCategoryID = c.ProductCategoryID
WHERE NOT EXISTS (
    SELECT 1 FROM stg_productcosthistory h WHERE h.ProductID = p.ProductID
);</sql>
